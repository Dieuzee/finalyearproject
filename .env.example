# Copy this file to ".env" to configure Ollama Cloud.
# 1. Create a free key at https://ollama.com  (Account -> Keys)
# 2. Paste it below as OLLAMA_API_KEY
# 3. Pick a cloud vision model from https://ollama.com/search?c=cloud

# Ollama Cloud endpoint (use http://localhost:11434 for a local server instead).
OLLAMA_HOST=https://ollama.com

# Your Ollama Cloud API key (keep this secret - never commit it).
OLLAMA_API_KEY=

# Which cloud vision model to use (see https://ollama.com/search?c=cloud)
OLLAMA_MODEL=gemma4
