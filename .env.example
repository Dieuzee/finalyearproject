# Copy this file to ".env" and fill in your key.
# Get a free Gemini API key at https://aistudio.google.com/apikey

# Enables the reliable Gemini vision leaf-check (rejects non-crop-leaf images)
# and the optional "AI assistant notes" on the results page.
GEMINI_API_KEY=

# Optional - which Gemini model to use (default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest
